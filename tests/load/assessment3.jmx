<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Assessment 3 builder and generated activity workflow" enabled="true">
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
